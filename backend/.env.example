# ─── discipline-os backend — environment variables ───────────────────────────
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (from Neon / Supabase / Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT secret — any long random string, e.g.:  openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret

# Optional: Allowed frontend origin (in addition to the hardcoded list)
# FRONTEND_URL=https://your-custom-domain.com

# Port (Render sets this automatically — do not change on prod)
PORT=5000
